{
  "name": "flamefront",
  "version": "0.0.0",
  "description": "Typed centralized route manifests for Octane.",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "private": true,
  "bin": {
    "ff": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./octane-server": "./src/octane-server.ts",
    "./remix-router": "./src/remix-router.ts",
    "./remix-router/data": "./src/remix-route-data.ts",
    "./server": "./src/server.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@alloc/cmd-ts": "0.17.1",
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@remix-run/route-pattern": "0.24.0",
    "babel-dead-code-elimination": "^1.0.12",
    "srvx": "0.12.5"
  },
  "peerDependencies": {
    "@octanejs/remix-router": "0.1.36",
    "octane": "0.1.40",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@octanejs/remix-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vite": "latest"
  }
}
