{
  "name": "flamefront",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Typed centralized route manifests for Octane.",
  "license": "FSL-1.1-MIT",
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ff": "./bin/ff.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./entry": "./src/entry.ts",
    "./fetch": "./src/fetch.ts",
    "./fragment": "./src/fragment.tsx",
    "./octane": "./src/octane.tsx",
    "./octane/client": "./src/octane-client.ts",
    "./octane/router-document": "./src/octane-router-document.ts",
    "./remix-router": "./src/remix-router.ts",
    "./remix-router/data": "./src/remix-route-data.ts",
    "./server": "./src/server.ts",
    "./output": "./src/output.ts",
    "./srvx": "./src/srvx.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@alloc/cmd-ts": "0.17.1",
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@remix-run/route-pattern": "0.24.0",
    "babel-dead-code-elimination": "^1.0.12",
    "satteri": "^0.10.5",
    "srvx": "0.12.5",
    "vite-plugin-satteri": "^0.3.5"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vite": "latest",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@octanejs/remix-router": "0.1.36",
    "octane": "0.1.40",
    "vite": "^8.0.16"
  },
  "peerDependenciesMeta": {
    "@octanejs/remix-router": {
      "optional": true
    }
  }
}
